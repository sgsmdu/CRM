rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isRootAdmin() {
      return isSignedIn() && userEmail() == 'spidergridsolutions@gmail.com';
    }

    function isAllowedUser() {
      return isSignedIn() && (
        isRootAdmin() ||
        exists(/databases/$(database)/documents/allowed_users/$(userEmail()))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isRootAdmin() ||
        (
          exists(/databases/$(database)/documents/allowed_users/$(userEmail())) &&
          get(/databases/$(database)/documents/allowed_users/$(userEmail())).data.role == 'admin'
        )
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allowed Users & RBAC collection
    match /allowed_users/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow delete: if isAdmin() && email != 'spidergridsolutions@gmail.com';
    }

    // Job Cards
    match /job_cards/{jobId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Billing Invoices
    match /invoices/{invoiceId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Customer Directory
    match /customers/{customerId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Vendor Bills / Stock Invoices
    match /vendor_bills/{billId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Manual Quotations
    match /quotations/{quotationId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // App Settings / Config
    match /settings/{settingId} {
      allow read: if isAllowedUser();
      allow write: if isAdmin();
    }

    // Inventory & Stock Movements
    match /inventory/{itemId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /stock_transactions/{txId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Money Flow & Accounting Ledgers
    match /cashflow/{entryId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /bank_accounts/{accId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /money_flow_categories/{catId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /invoice_payments/{payId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /vendor_payments/{payId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /customer_payment_allocations/{allocId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Lead Sources & Vendors
    match /lead_sources/{leadId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /vendors/{vendorId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Staff, Attendance, Salary & Work Allocations
    match /employees/{empId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /attendance/{attId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /salary_payments/{salId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /work_allocations/{allocId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /salary_advances/{advId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Manual Quotation Catalogue
    match /quotation_categories/{catId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /quotation_subcategories/{subId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /quotation_products/{prodId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }

    // Advanced Financial Management (Loans, EMI, Recurring, Savings, Investments)
    match /loans/{loanId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /loan_payments/{payId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /recurring_expenses/{recId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /recurring_due_entries/{dueId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /savings_accounts/{savId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /savings_transactions/{txId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /investments/{invId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
    match /investment_transactions/{txId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser();
      allow delete: if isAdmin();
    }
  }
}
