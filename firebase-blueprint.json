{
  "entities": {
    "AllowedUser": {
      "title": "AllowedUser",
      "description": "Authorized CRM user and RBAC permissions",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Google user email address" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "Permission role" },
        "displayName": { "type": "string", "description": "User display name" },
        "notes": { "type": "string", "description": "Staff designation or notes" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["email", "role"]
    },
    "JobCard": {
      "title": "JobCard",
      "description": "Hardware and service repair work order card",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerArea": { "type": "string" },
        "category": { "type": "string" },
        "deviceBrand": { "type": "string" },
        "issueDescription": { "type": "string" },
        "status": { "type": "string" },
        "intakeDate": { "type": "string" },
        "estimatedCost": { "type": "number" },
        "finalCost": { "type": "number" },
        "advancePaid": { "type": "number" },
        "linkedVendorBillIds": { "type": "array" }
      },
      "required": ["id", "jobId", "customerName", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "GST Tax invoice or Pandiyan computer estimate bill",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "date": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "items": { "type": "array" }
      },
      "required": ["id", "invoiceNumber", "customerName", "type"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer database entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "area": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "VendorBill": {
      "title": "VendorBill",
      "description": "Stock purchase bill from vendor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "vendorName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "linkedJobCardIds": { "type": "array" }
      },
      "required": ["id", "invoiceNumber", "vendorName"]
    },
    "ManualQuotation": {
      "title": "ManualQuotation",
      "description": "Manual sales proposal / quotation with up to 5 models",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quotationNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "quotationNumber", "customerName"]
    },
    "MoneyFlowCategory": {
      "title": "MoneyFlowCategory",
      "description": "3-level Money Flow category tree (Category -> Subcategory -> 2nd Subcategory)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "number" },
        "parentId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense", "both"] },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "level", "type", "isActive"]
    },
    "InvoicePaymentRecord": {
      "title": "InvoicePaymentRecord",
      "description": "Incremental customer/invoice/job advance payment receipt record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMode": { "type": "string" },
        "accountType": { "type": "string", "enum": ["cash", "bank"] },
        "bankAccountId": { "type": "string" },
        "uniqueSourceKey": { "type": "string" }
      },
      "required": ["id", "customerId", "amount", "date", "accountType"]
    },
    "CustomerPaymentAllocation": {
      "title": "CustomerPaymentAllocation",
      "description": "Multi-invoice customer payment allocation with optional unallocated credit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "allocatedTotal": { "type": "number" },
        "unallocatedAmount": { "type": "number" },
        "accountType": { "type": "string" }
      },
      "required": ["id", "customerId", "totalAmount", "accountType"]
    },
    "VendorPaymentRecord": {
      "title": "VendorPaymentRecord",
      "description": "Incremental vendor bill payment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vendorBillId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "accountType": { "type": "string" }
      },
      "required": ["id", "vendorBillId", "amount", "date", "accountType"]
    },
    "LoanAccount": {
      "title": "LoanAccount",
      "description": "Business, personal, gold, vehicle, home or private finance loan liability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loanName": { "type": "string" },
        "loanType": { "type": "string" },
        "lenderName": { "type": "string" },
        "originalAmount": { "type": "number" },
        "outstandingPrincipal": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "loanName", "loanType", "originalAmount", "status"]
    },
    "LoanPayment": {
      "title": "LoanPayment",
      "description": "EMI, gold interest, principal prepayment or closure payment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loanId": { "type": "string" },
        "totalPaid": { "type": "number" },
        "principalComponent": { "type": "number" },
        "interestComponent": { "type": "number" },
        "paymentDate": { "type": "string" }
      },
      "required": ["id", "loanId", "totalPaid", "paymentDate"]
    },
    "RecurringExpense": {
      "title": "RecurringExpense",
      "description": "Recurring expense template with 3-level category and reminder lead time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "frequency": { "type": "string" },
        "nextDueDate": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "amount", "frequency", "isActive"]
    },
    "RecurringDueEntry": {
      "title": "RecurringDueEntry",
      "description": "Period due payable reminder entry (never auto-deducts cash/bank)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recurringExpenseId": { "type": "string" },
        "duePeriod": { "type": "string" },
        "dueDate": { "type": "string" },
        "amountDue": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "recurringExpenseId", "duePeriod", "status"]
    },
    "SavingsAccount": {
      "title": "SavingsAccount",
      "description": "Separate savings & business reserve account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "savingsType": { "type": "string" },
        "currentBalance": { "type": "number" }
      },
      "required": ["id", "name", "savingsType", "currentBalance"]
    },
    "SavingsTransaction": {
      "title": "SavingsTransaction",
      "description": "Deposit, withdrawal or transfer to/from savings reserve",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "savingsAccountId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "savingsAccountId", "type", "amount", "date"]
    },
    "InvestmentAccount": {
      "title": "InvestmentAccount",
      "description": "FD, RD, Mutual Fund, Stocks, Gold or Other Investment tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "investmentType": { "type": "string" },
        "investedAmount": { "type": "number" },
        "currentValue": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "investmentType", "investedAmount", "currentValue", "status"]
    },
    "InvestmentTransaction": {
      "title": "InvestmentTransaction",
      "description": "Capital addition, withdrawal, or manual valuation update",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "investmentId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "investmentId", "type", "amount", "date"]
    }
  },
  "firestore": {
    "/allowed_users/{email}": {
      "schema": { "$ref": "#/entities/AllowedUser" },
      "description": "Authorized CRM users with roles (admin or user)"
    },
    "/job_cards/{jobId}": {
      "schema": { "$ref": "#/entities/JobCard" },
      "description": "Workshop service & repair job cards"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Customer billing invoices and receipts"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer directory"
    },
    "/vendor_bills/{billId}": {
      "schema": { "$ref": "#/entities/VendorBill" },
      "description": "Vendor purchase stock bills"
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/ManualQuotation" },
      "description": "Multi-model quotation proposals"
    },
    "/money_flow_categories/{catId}": {
      "schema": { "$ref": "#/entities/MoneyFlowCategory" },
      "description": "Dynamic 3-level Money Flow categories"
    },
    "/invoice_payments/{payId}": {
      "schema": { "$ref": "#/entities/InvoicePaymentRecord" },
      "description": "Per-invoice and advance payment records"
    },
    "/customer_payment_allocations/{allocId}": {
      "schema": { "$ref": "#/entities/CustomerPaymentAllocation" },
      "description": "Multi-invoice customer payment allocations"
    },
    "/vendor_payments/{payId}": {
      "schema": { "$ref": "#/entities/VendorPaymentRecord" },
      "description": "Vendor bill payment records"
    },
    "/loans/{loanId}": {
      "schema": { "$ref": "#/entities/LoanAccount" },
      "description": "Loans and gold loans register"
    },
    "/loan_payments/{payId}": {
      "schema": { "$ref": "#/entities/LoanPayment" },
      "description": "Loan EMI, interest, and closure payment records"
    },
    "/recurring_expenses/{recId}": {
      "schema": { "$ref": "#/entities/RecurringExpense" },
      "description": "Recurring expense templates"
    },
    "/recurring_due_entries/{dueId}": {
      "schema": { "$ref": "#/entities/RecurringDueEntry" },
      "description": "Generated recurring expense due entries"
    },
    "/savings_accounts/{savId}": {
      "schema": { "$ref": "#/entities/SavingsAccount" },
      "description": "Savings and business reserve accounts"
    },
    "/savings_transactions/{txId}": {
      "schema": { "$ref": "#/entities/SavingsTransaction" },
      "description": "Savings deposits, withdrawals and transfers"
    },
    "/investments/{invId}": {
      "schema": { "$ref": "#/entities/InvestmentAccount" },
      "description": "FD, RD, mutual fund, stock, and gold investments"
    },
    "/investment_transactions/{txId}": {
      "schema": { "$ref": "#/entities/InvestmentTransaction" },
      "description": "Investment contributions, withdrawals, and valuation history"
    }
  }
}
